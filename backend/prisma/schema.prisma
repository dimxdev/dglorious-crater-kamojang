generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  SUPER_ADMIN
  OWNER
  ADMIN_PENGINAPAN
}

enum BookingStatus {
  DP
  LUNAS
  CHECKED_IN
  HANGUS
  COMPLETED
  NO_SHOW
}

enum BookingChannel {
  WHATSAPP
  WALK_IN
}

enum ExtraBedType {
  WITH_BED
  WITHOUT_BED
}

enum BookingSource {
  MANUAL
}

enum PaymentMethod {
  CASH
  QRIS
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
}

enum RoomUnitStatus {
  AVAILABLE
}

enum LanguageCode {
  ID
  EN
}

model Role {
  id        Int      @id @default(autoincrement())
  name      RoleName @unique
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id        Int      @id @default(autoincrement())
  roleId    Int      @map("role_id")
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id])

  createdRoomTypes RoomType[]       @relation("RoomTypeCreatedBy")
  createdBookings  Booking[]        @relation("BookingCreatedBy")
  verifiedPayments Payment[]        @relation("PaymentVerifiedBy")
  updatedSettings  Setting[]        @relation("SettingUpdatedBy")
  editedBookings   BookingEditLog[] @relation("BookingEditedBy")

  @@map("users")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById Int?     @map("updated_by")

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("settings")
}

model RoomType {
  id           Int     @id @default(autoincrement())
  slug         String  @unique
  priceWeekday Decimal @map("price_weekday") @db.Decimal(12, 2)
  priceWeekend Decimal @map("price_weekend") @db.Decimal(12, 2)
  capacity     Int
  totalUnits   Int     @map("total_units")

  extraBedPrice   Decimal? @map("extra_bed_price") @db.Decimal(12, 2)
  extraNoBedPrice Decimal? @map("extra_no_bed_price") @db.Decimal(12, 2)
  extraFlatPrice  Decimal? @map("extra_flat_price") @db.Decimal(12, 2)

  facilities  Json      @default("[]")
  isActive    Boolean   @default(true) @map("is_active")
  createdById Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy    User?                 @relation("RoomTypeCreatedBy", fields: [createdById], references: [id])
  translations RoomTypeTranslation[]
  images       RoomImage[]
  units        RoomUnit[]
  bookingItems BookingItem[]

  @@map("room_types")
}

model RoomTypeTranslation {
  id             Int          @id @default(autoincrement())
  roomTypeId     Int          @map("room_type_id")
  languageCode   LanguageCode @map("language_code")
  name           String
  category       String
  tagline        String?
  description    String?
  bedInfo        String?      @map("bed_info")
  bathroomInfo   String?      @map("bathroom_info")
  facilitiesText String?      @map("facilities_text")
  rules          String?

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, languageCode])
  @@map("room_type_translations")
}

model RoomImage {
  id         Int     @id @default(autoincrement())
  roomTypeId Int     @map("room_type_id")
  imageUrl   String  @map("image_url")
  isCover    Boolean @default(false) @map("is_cover")
  sortOrder  Int     @default(0) @map("sort_order")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_images")
}

model RoomUnit {
  id         Int            @id @default(autoincrement())
  roomTypeId Int            @map("room_type_id")
  unitCode   String         @map("unit_code")
  status     RoomUnitStatus @default(AVAILABLE)

  roomType     RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@unique([roomTypeId, unitCode])
  @@map("room_units")
}

model Booking {
  id          Int      @id @default(autoincrement())
  bookingCode String   @unique @map("booking_code")
  guestName   String   @map("guest_name")
  guestPhone  String   @map("guest_phone")
  guestEmail  String?  @map("guest_email")
  createdAt   DateTime @default(now()) @map("created_at")
  checkIn     DateTime @map("check_in") @db.Date
  checkOut    DateTime @map("check_out") @db.Date

  priceSnapshot       Decimal  @map("price_snapshot") @db.Decimal(12, 2)
  isPriceOverride     Boolean  @default(false) @map("is_price_override")
  autoCalculatedTotal Decimal? @map("auto_calculated_total") @db.Decimal(12, 2)
  discount            Decimal  @default(0) @map("discount") @db.Decimal(12, 2)

  status         BookingStatus  @default(DP)
  bookingChannel BookingChannel @map("booking_channel")
  bookingSource  BookingSource  @map("booking_source")

  notes       String?
  createdById Int?    @map("created_by")

  lunasAt     DateTime? @map("lunas_at")
  checkedInAt DateTime? @map("checked_in_at")
  hangusAt    DateTime? @map("hangus_at")

  createdBy User?            @relation("BookingCreatedBy", fields: [createdById], references: [id])
  items     BookingItem[]
  payments  Payment[]
  editLogs  BookingEditLog[]

  @@index([status])
  @@index([checkIn, checkOut])
  @@index([createdAt])
  @@index([bookingChannel])
  @@map("bookings")
}

model BookingEditLog {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @map("booking_id")
  editedById Int      @map("edited_by_id")
  editedAt   DateTime @default(now()) @map("edited_at")
  note       String
  changes    Json

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  editedBy User    @relation("BookingEditedBy", fields: [editedById], references: [id])

  @@index([bookingId])
  @@map("booking_edit_logs")
}

model BookingItem {
  id               Int     @id @default(autoincrement())
  bookingId        Int     @map("booking_id")
  roomTypeId       Int     @map("room_type_id")
  roomUnitId       Int?    @map("room_unit_id")
  qty              Int     @default(1)
  subtotalSnapshot Decimal @map("subtotal_snapshot") @db.Decimal(12, 2)

  adults        Int           @default(1)
  children      Int           @default(0)
  extraBedQty   Int           @default(0) @map("extra_bed_qty")
  extraBedType  ExtraBedType? @map("extra_bed_type")
  extraBedPrice Decimal       @default(0) @map("extra_bed_price") @db.Decimal(12, 2)

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType RoomType  @relation(fields: [roomTypeId], references: [id])
  roomUnit RoomUnit? @relation(fields: [roomUnitId], references: [id])

  @@index([bookingId])
  @@index([roomTypeId])
  @@map("booking_items")
}

model Payment {
  id           Int           @id @default(autoincrement())
  bookingId    Int           @map("booking_id")
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  proofUrl     String?       @map("proof_url")
  status       PaymentStatus @default(PENDING)
  paidAt       DateTime?     @map("paid_at")
  verifiedById Int?          @map("verified_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])

  @@map("payments")
}
