generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  SUPER_ADMIN
  OWNER
  ADMIN_PENGINAPAN
}

enum ReservationStatus {
  DP
  LUNAS
  CHECKED_IN
  HANGUS
  COMPLETED
  NO_SHOW
}

enum ReservationChannel {
  RESERVASI
  LANGSUNG
}

enum ExtraBedType {
  WITH_BED
  WITHOUT_BED
}

enum PaymentMethod {
  CASH
  QRIS
  BANK_TRANSFER
}

enum LanguageCode {
  ID
  EN
}

model Role {
  id        Int      @id @default(autoincrement())
  name      RoleName @unique
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id        Int      @id @default(autoincrement())
  roleId    Int      @map("role_id")
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  createdRoomTypes    RoomType[]           @relation("RoomTypeCreatedBy")
  createdReservations Reservation[]        @relation("ReservationCreatedBy")
  recordedPayments    Payment[]            @relation("PaymentRecordedBy")
  editedReservations  ReservationEditLog[] @relation("ReservationEditedBy")

  updatedSiteSections SiteSection[] @relation("SiteSectionUpdatedBy")
  updatedContentItems ContentItem[] @relation("ContentItemUpdatedBy")

  @@map("users")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model RoomType {
  id           Int     @id @default(autoincrement())
  slug         String  @unique
  priceWeekday Decimal @map("price_weekday") @db.Decimal(12, 2)
  priceWeekend Decimal @map("price_weekend") @db.Decimal(12, 2)
  capacity     Int
  totalUnits   Int     @map("total_units")

  extraBedPrice   Decimal? @map("extra_bed_price") @db.Decimal(12, 2)
  extraNoBedPrice Decimal? @map("extra_no_bed_price") @db.Decimal(12, 2)
  extraFlatPrice  Decimal? @map("extra_flat_price") @db.Decimal(12, 2)

  facilities  Json      @default("[]")
  isActive    Boolean   @default(true) @map("is_active")
  createdById Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy        User?                 @relation("RoomTypeCreatedBy", fields: [createdById], references: [id])
  translations     RoomTypeTranslation[]
  images           RoomImage[]
  reservationItems ReservationItem[]

  @@map("room_types")
}

model RoomTypeTranslation {
  id           Int          @id @default(autoincrement())
  roomTypeId   Int          @map("room_type_id")
  languageCode LanguageCode @map("language_code")
  name         String
  category     String
  tagline      String?
  description  String?
  bedInfo      String?      @map("bed_info")
  bathroomInfo String?      @map("bathroom_info")
  rules        String?

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, languageCode])
  @@map("room_type_translations")
}

model RoomImage {
  id         Int     @id @default(autoincrement())
  roomTypeId Int     @map("room_type_id")
  imageUrl   String  @map("image_url")
  isCover    Boolean @default(false) @map("is_cover")
  sortOrder  Int     @default(0) @map("sort_order")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_images")
}

model Reservation {
  id              Int      @id @default(autoincrement())
  reservationCode String   @unique @map("reservation_code")
  guestName       String   @map("guest_name")
  guestPhone      String   @map("guest_phone")
  createdAt       DateTime @default(now()) @map("created_at")
  checkIn         DateTime @map("check_in") @db.Date
  checkOut        DateTime @map("check_out") @db.Date

  priceSnapshot       Decimal  @map("price_snapshot") @db.Decimal(12, 2)
  isPriceOverride     Boolean  @default(false) @map("is_price_override")
  autoCalculatedTotal Decimal? @map("auto_calculated_total") @db.Decimal(12, 2)
  discount            Decimal  @default(0) @map("discount") @db.Decimal(12, 2)

  status  ReservationStatus  @default(DP)
  channel ReservationChannel

  notes       String?
  createdById Int?    @map("created_by")

  lunasAt     DateTime? @map("lunas_at")
  checkedInAt DateTime? @map("checked_in_at")
  hangusAt    DateTime? @map("hangus_at")

  createdBy User?                @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  items     ReservationItem[]
  payments  Payment[]
  editLogs  ReservationEditLog[]

  @@index([status])
  @@index([checkIn, checkOut])
  @@index([createdAt])
  @@index([channel])
  @@map("reservations")
}

model ReservationEditLog {
  id            Int      @id @default(autoincrement())
  reservationId Int      @map("reservation_id")
  editedById    Int      @map("edited_by_id")
  editedAt      DateTime @default(now()) @map("edited_at")
  note          String
  changes       Json

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  editedBy    User        @relation("ReservationEditedBy", fields: [editedById], references: [id])

  @@index([reservationId])
  @@map("reservation_edit_logs")
}

model ReservationItem {
  id               Int     @id @default(autoincrement())
  reservationId    Int     @map("reservation_id")
  roomTypeId       Int     @map("room_type_id")
  qty              Int     @default(1)
  subtotalSnapshot Decimal @map("subtotal_snapshot") @db.Decimal(12, 2)

  adults        Int           @default(1)
  children      Int           @default(0)
  extraBedQty   Int           @default(0) @map("extra_bed_qty")
  extraBedType  ExtraBedType? @map("extra_bed_type")
  extraBedPrice Decimal       @default(0) @map("extra_bed_price") @db.Decimal(12, 2)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomType    RoomType    @relation(fields: [roomTypeId], references: [id])

  @@index([reservationId])
  @@index([roomTypeId])
  @@map("reservation_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  reservationId Int           @map("reservation_id")
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  paidAt        DateTime      @default(now()) @map("paid_at")
  recordedById  Int?          @map("recorded_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  recordedBy  User?       @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([reservationId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// CMS konten situs (company profile dwibahasa, dikelola SUPER_ADMIN)
// ─────────────────────────────────────────────────────────────
enum ContentCollection {
  ATTRACTION
  INFO_CARD
  ROUTE
  FAQ
  TICKET_PACKAGE
  PARKING_FEE
  GALLERY
  FACILITY_ZONE
}

// Satu baris per blok teks halaman (key tetap, bentuk `content` divalidasi di service).
model SiteSection {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  content     Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById Int?     @map("updated_by")
  updatedBy   User?    @relation("SiteSectionUpdatedBy", fields: [updatedById], references: [id])

  @@map("site_sections")
}

// Item daftar (atraksi, FAQ, tiket, dst.) — bentuk `content` tergantung koleksi.
model ContentItem {
  id          Int               @id @default(autoincrement())
  collection  ContentCollection
  sortOrder   Int               @default(0) @map("sort_order")
  isActive    Boolean           @default(true) @map("is_active")
  imageUrl    String?           @map("image_url")
  content     Json
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  updatedById Int?              @map("updated_by")
  updatedBy   User?             @relation("ContentItemUpdatedBy", fields: [updatedById], references: [id])

  @@index([collection, sortOrder])
  @@map("content_items")
}
