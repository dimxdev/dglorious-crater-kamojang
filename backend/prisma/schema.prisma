// Prisma schema — D'Glorious Crater Kamojang
// Docs: https://pris.ly/d/prisma-schema
//
// Konvensi (lihat PROJECT.md §13):
//   - Model  : PascalCase   (kode)
//   - Field  : camelCase    (kode)  → dipetakan ke snake_case di database via @map
//   - Tabel  : snake_case   (database) via @@map
//
// Aturan analytics-ready (§4.7): timestamp lengkap di setiap transisi status,
// enum konsisten, soft delete (deleted_at), created_by untuk jejak audit.
//
// Scope Fase 1 (lihat PROJECT.md banner atas): company profile publik +
// pencatatan booking internal oleh admin. Field/enum yang ditandai
// "fase berikutnya" sudah disiapkan di skema tapi BELUM dipakai alurnya.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUM
// ─────────────────────────────────────────────────────────────

/// Daftar identifier role. Dipakai sebagai tipe kolom `roles.name`.
/// (Di TASK.md disebut "enum Role"; dinamai RoleName agar tidak bentrok
/// dengan model tabel `Role` di bawah.)
enum RoleName {
  SUPER_ADMIN
  OWNER
  ADMIN_PENGINAPAN
  ADMIN_PORTAL // fase berikutnya — belum aktif, struktur disiapkan
  ADMIN_CAFFE // fase berikutnya — belum aktif, struktur disiapkan
}

/// HANYA status yang benar-benar DISIMPAN (revisi 2026-07-26, disamakan dengan
/// keputusan di frontend `lib/data/admin.ts` + PROJECT.md §6.2):
///   DP → LUNAS → CHECKED_IN, cabang HANGUS kapan saja sebelum check-in.
///
/// COMPLETED & NO_SHOW bisa disimpan secara manual (admin tandai lebih awal)
/// ATAU dihitung otomatis dari tanggal checkout di endpoint GET. Stored value
/// menang atas komputasi otomatis — kalau sudah tersimpan, dikembalikan as-is.
///
/// Nilai lama `CONFIRMED` dihapus — digantikan pemisahan DP/LUNAS. Nilai lama
/// `CANCELLED` juga dihapus — dari sisi bisnis batal-manual & uang hangus itu
/// hal yang sama, jadi digabung ke `HANGUS` (S&K poin 5).
///
/// Fase berikutnya (booking online, BELUM dipakai di fase 1): PENDING →
/// WAITING_PAYMENT → PAID, cabang EXPIRED (auto-expire 1x24 jam) / REJECTED.
enum BookingStatus {
  DP
  LUNAS
  CHECKED_IN
  HANGUS
  COMPLETED // checkout lebih awal (manual) atau otomatis saat checkOut lewat
  NO_SHOW   // lunas tapi tidak datang (manual) atau otomatis saat checkOut lewat
  PENDING // fase berikutnya
  WAITING_PAYMENT // fase berikutnya
  PAID // fase berikutnya
  EXPIRED // fase berikutnya
  REJECTED // fase berikutnya
}

/// Menu mana yang dipakai admin buat mencatat booking. BEDA dari
/// `BookingSource` (yang tetap MANUAL untuk dua-duanya, lihat PROJECT.md §6.1):
/// ini dipakai buat filter, badge, breakdown laporan, & export.
enum BookingChannel {
  WHATSAPP // tamu belum tiba — DP dulu, check-in belakangan
  WALK_IN // tamu sudah di lokasi — langsung lunas & CHECKED_IN
}

/// Jenis penambahan orang di luar kapasitas (§"KETENTUAN PENAMBAHAN ORANG" di
/// price list resmi): dengan kasur tambahan, atau cuma nambah orang tanpa kasur.
enum ExtraBedType {
  WITH_BED
  WITHOUT_BED
}

enum BookingSource {
  MANUAL // fase 1 — admin input booking yang sudah fix (via WhatsApp)
  ONLINE // fase berikutnya — guest checkout mandiri (Midtrans)
}

enum PaymentMethod {
  CASH
  QRIS
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  EWALLET
  CREDIT_CARD
  OTHER
}

/// Status transaksi pembayaran individual (tabel `payments`). Nilai terkait
/// pembayaran online (webhook Midtrans) disiapkan untuk fase berikutnya.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum RoomUnitStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

/// Fase 1 mengisi ID + EN. ZH (Mandarin) disiapkan strukturnya, diisi di fase
/// berikutnya — cukup menambah data, jangan hardcode / jangan jadi 2 kolom.
enum LanguageCode {
  ID
  EN
  ZH
}

// ─────────────────────────────────────────────────────────────
// AUTH & RBAC
// ─────────────────────────────────────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id        Int      @id @default(autoincrement())
  roleId    Int      @map("role_id")
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id])

  // Jejak audit (created_by / verified_by / updated_by)
  createdRoomTypes RoomType[] @relation("RoomTypeCreatedBy")
  createdBookings  Booking[]  @relation("BookingCreatedBy")
  verifiedPayments Payment[]  @relation("PaymentVerifiedBy")
  updatedSettings  Setting[]  @relation("SettingUpdatedBy")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// SETTINGS (konfigurasi global — §8.3 PROJECT.md, JANGAN hardcode)
// ─────────────────────────────────────────────────────────────

/// Konfigurasi global yang bisa diubah admin lewat /admin/settings.
/// Contoh key: check_in_time, check_out_time, whatsapp_number, bank_account,
/// terms_conditions. Value disimpan sebagai teks bebas (boleh multi-baris/JSON).
model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById Int?     @map("updated_by")

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("settings")
}

// ─────────────────────────────────────────────────────────────
// PENGINAPAN — "Tenda" / "Villa" di UI (room types, translations, images, unit)
// ─────────────────────────────────────────────────────────────

model RoomType {
  id           Int     @id @default(autoincrement())
  slug         String  @unique
  priceWeekday Decimal @map("price_weekday") @db.Decimal(12, 2)
  priceWeekend Decimal @map("price_weekend") @db.Decimal(12, 2)
  capacity     Int
  totalUnits   Int     @map("total_units")

  /// Tarif penambahan orang di luar kapasitas (§"KETENTUAN PENAMBAHAN ORANG"
  /// di price list resmi). Satu kolom `extra_bed_price` saja TIDAK cukup:
  /// hampir semua unit punya 2 tarif (dengan vs tanpa kasur tambahan), dan
  /// Glorious Campervan malah flat per orang — makanya 3 kolom nullable.
  /// Dipilih berdasarkan `Booking.extraBedType`; `extraFlatPrice` menang
  /// duluan kalau terisi. Lihat `frontend/lib/pricing.ts#extraBedRate`.
  extraBedPrice   Decimal? @map("extra_bed_price") @db.Decimal(12, 2)
  extraNoBedPrice Decimal? @map("extra_no_bed_price") @db.Decimal(12, 2)
  extraFlatPrice  Decimal? @map("extra_flat_price") @db.Decimal(12, 2)

  facilities  Json      @default("[]") // daftar key fasilitas (ikon), teks per bahasa ada di translations
  isActive    Boolean   @default(true) @map("is_active")
  createdById Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // soft delete

  // Jam check-in/out TIDAK di sini — ambil dari tabel `settings` (global, §8.3).

  createdBy    User?                 @relation("RoomTypeCreatedBy", fields: [createdById], references: [id])
  translations RoomTypeTranslation[]
  images       RoomImage[]
  units        RoomUnit[]
  bookingItems BookingItem[]

  @@map("room_types")
}

/// Konten dinamis multi-bahasa (§9). Tab ID wajib, EN opsional (fase 1);
/// ZH (Mandarin) disiapkan, diisi di fase berikutnya. Fallback ke ID jika kosong.
model RoomTypeTranslation {
  id           Int          @id @default(autoincrement())
  roomTypeId   Int          @map("room_type_id")
  languageCode LanguageCode @map("language_code")
  name         String
  /// Kategori unit (Cottage / Glamping / Tenda / Area Camping) — ikut
  /// diterjemahkan, dipakai di katalog publik, tabel Admin, & laporan Owner.
  category     String
  tagline      String?
  description  String?
  /// Ringkasan kasur & kamar mandi buat halaman detail publik
  /// (mis. "1 bed queen size" / "Kamar mandi dalam, air panas").
  bedInfo       String? @map("bed_info")
  bathroomInfo  String? @map("bathroom_info")
  facilitiesText String? @map("facilities_text")
  rules          String?

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, languageCode])
  @@map("room_type_translations")
}

model RoomImage {
  id         Int     @id @default(autoincrement())
  roomTypeId Int     @map("room_type_id")
  imageUrl   String  @map("image_url")
  isCover    Boolean @default(false) @map("is_cover")
  sortOrder  Int     @default(0) @map("sort_order")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_images")
}

/// Unit fisik (tenda/villa). Ketersediaan dihitung terhadap unit ini.
model RoomUnit {
  id         Int            @id @default(autoincrement())
  roomTypeId Int            @map("room_type_id")
  unitCode   String         @map("unit_code")
  status     RoomUnitStatus @default(AVAILABLE)

  roomType     RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@unique([roomTypeId, unitCode])
  @@map("room_units")
}

// ─────────────────────────────────────────────────────────────
// BOOKING, PAYMENT, TICKET
// ─────────────────────────────────────────────────────────────

/// Booking fase 1 = pencatatan internal oleh admin (booking yang sudah fix,
/// nego terjadi di WhatsApp). Bisa mencakup lebih dari satu tenda → lihat
/// BookingItem. Status langsung CONFIRMED saat dibuat (§6.1 PROJECT.md).
model Booking {
  id          Int      @id @default(autoincrement())
  bookingCode String   @unique @map("booking_code") // acak, sulit ditebak (§7)
  guestName   String   @map("guest_name")
  guestPhone  String   @map("guest_phone")
  guestEmail  String?  @map("guest_email")
  /// Tanggal booking DIBUAT — beda dari `checkIn`. Jalur WhatsApp biasanya
  /// beberapa hari sebelum check-in (ada jeda nego di WA), Walk-in sama
  /// dengan `checkIn`. Ditampilkan sebagai kolom "Tgl. Booking" di UI.
  createdAt   DateTime @default(now()) @map("created_at")
  checkIn     DateTime @map("check_in") @db.Date
  checkOut    DateTime @map("check_out") @db.Date

  // Dewasa/anak/extra-bed (§8.2) disimpan di `BookingItem`, BUKAN di sini —
  // satu booking bisa mencakup beberapa tenda dengan komposisi tamu &
  // extra bed yang beda-beda per tenda (keputusan 2026-08-02, sejalan
  // dengan `RoomGroupEditor.tsx` di frontend: "satu baris grup = satu unit
  // fisik" dengan dewasa/anak/extra-bed sendiri-sendiri).

  priceSnapshot   Decimal @map("price_snapshot") @db.Decimal(12, 2) // §4.5 total dibekukan (SUDAH dikurangi discount)
  isPriceOverride Boolean @default(false) @map("is_price_override") // admin override manual (nego)
  /// Potongan nominal opsional (bukan persen) — dicatat terpisah dari
  /// `priceSnapshot` biar keliatan di detail booking, walau `priceSnapshot`
  /// sendiri sudah net (harga jual - discount). Berlaku baik untuk total
  /// otomatis maupun `isPriceOverride` (keduanya dikurangi discount yang sama).
  discount Decimal @default(0) @map("discount") @db.Decimal(12, 2)

  status         BookingStatus  @default(DP)
  /// WHATSAPP vs WALK_IN — dipakai filter/badge/laporan. Lihat enum BookingChannel.
  bookingChannel BookingChannel @map("booking_channel")
  /// MANUAL untuk dua-duanya di fase 1; ONLINE baru fase berikutnya (§6.1).
  bookingSource  BookingSource  @map("booking_source")

  notes       String?
  createdById Int?    @map("created_by") // admin yang input

  // Timestamp tiap transisi status yang DISIMPAN (analytics-ready).
  // `COMPLETED` & `NO_SHOW` bisa tersimpan (manual) atau dihitung otomatis
  // dari `checkOut` vs hari ini — lihat catatan di enum BookingStatus.
  lunasAt     DateTime? @map("lunas_at")
  checkedInAt DateTime? @map("checked_in_at")
  hangusAt    DateTime? @map("hangus_at")
  // Fase berikutnya (booking online) — belum dipakai di fase 1
  expiredAt   DateTime? @map("expired_at")

  createdBy User?         @relation("BookingCreatedBy", fields: [createdById], references: [id])
  items     BookingItem[]
  payments  Payment[]
  ticket    Ticket?

  @@index([status])
  @@index([checkIn, checkOut])
  @@index([createdAt])
  @@index([bookingChannel])
  @@map("bookings")
}

/// Satu booking bisa mencakup lebih dari satu tenda/villa (§8.1 PROJECT.md:
/// "Tipe & jumlah tenda — bisa pilih lebih dari satu tenda").
model BookingItem {
  id               Int     @id @default(autoincrement())
  bookingId        Int     @map("booking_id")
  roomTypeId       Int     @map("room_type_id")
  roomUnitId       Int?    @map("room_unit_id") // unit spesifik, di-assign saat konfirmasi/check-in
  qty              Int     @default(1)
  subtotalSnapshot Decimal @map("subtotal_snapshot") @db.Decimal(12, 2) // tarif weekday/weekend × malam × qty, dibekukan

  // §8.2 — per tenda, bukan per booking (lihat catatan di model Booking).
  adults      Int @default(1)
  children    Int @default(0)
  extraBedQty Int @default(0) @map("extra_bed_qty")
  /// Relevan hanya kalau `extraBedQty > 0` — nentuin tarif mana yang dipakai
  /// (`RoomType.extraBedPrice` vs `extraNoBedPrice`).
  extraBedType  ExtraBedType? @map("extra_bed_type")
  extraBedPrice Decimal       @default(0) @map("extra_bed_price") @db.Decimal(12, 2) // tarif per orang, snapshot saat booking dibuat

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType RoomType  @relation(fields: [roomTypeId], references: [id])
  roomUnit RoomUnit? @relation(fields: [roomUnitId], references: [id])

  @@index([bookingId])
  @@index([roomTypeId])
  @@map("booking_items")
}

model Payment {
  id              Int           @id @default(autoincrement())
  bookingId       Int           @map("booking_id")
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  proofUrl        String?       @map("proof_url") // bukti transfer — opsional fase 1, wajib fase berikutnya
  midtransOrderId String?       @unique @map("midtrans_order_id") // fase berikutnya — idempotency webhook
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?     @map("paid_at")
  verifiedById    Int?          @map("verified_by") // admin yang mencatat/verifikasi
  createdAt       DateTime      @default(now()) @map("created_at")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])

  @@map("payments")
}

/// Struktur disiapkan; generate PDF+QR untuk tamu = fase berikutnya.
model Ticket {
  id        Int      @id @default(autoincrement())
  bookingId Int      @unique @map("booking_id") // 1 booking = 1 tiket
  qrUrl     String?  @map("qr_url")
  pdfUrl    String?  @map("pdf_url")
  issuedAt  DateTime @default(now()) @map("issued_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("tickets")
}
