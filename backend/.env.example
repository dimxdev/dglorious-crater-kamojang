# ── Backend (NestJS) environment ─────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the API listens on (frontend defaults to 3000, so keep this different).
PORT=3001

# Origin allowed to call the API (used for CORS).
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dglorious?schema=public"

# ── JWT / Auth (dipakai mulai FASE 2) ─────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# ── Midtrans (sandbox, dipakai mulai FASE 5) ──────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── SMTP / Email (dipakai mulai FASE 6) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="D'Glorious Crater <no-reply@dglorious.com>"
