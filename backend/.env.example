# ── Backend (NestJS) environment ─────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the API listens on (frontend defaults to 3000, so keep this different).
PORT=3001

# Origin allowed to call the API (used for CORS).
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dglorious?schema=public"

# ── JWT / Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
# 365d dipilih sengaja (bukan 1d) biar admin/owner gak perlu login ulang
# tiap hari selama masa KP — belum ada refresh-token, jadi token yang expired
# berarti login manual lagi. Kalau butuh lebih ketat, turunkan (mis. 7d).
JWT_EXPIRES_IN=365d
